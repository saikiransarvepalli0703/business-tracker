  em.style.display='none';
  const ledgers=DB.agencies.map(ag=>({...ag,...agLedger(ag.name)}));
  const totalPur=ledgers.reduce((s,l)=>s+l.totalPur,0);
  const totalPaid=ledgers.reduce((s,l)=>s+l.totalPaid,0);
  const totalBal=ledgers.reduce((s,l)=>s+l.balance,0);
  const pct=totalPur>0?((totalPaid/totalPur)*100).toFixed(1):0;
  document.getElementById('lk-total-pur').textContent=fmt(totalPur);
  document.getElementById('lk-total-paid').textContent=fmt(totalPaid);
  document.getElementById('lk-total-bal').textContent=fmt(totalBal);
  document.getElementById('lk-pct').textContent=pct+'%';
  grid.innerHTML=ledgers.sort((a,b)=>b.balance-a.balance).map((l,i)=>{
    let status,sClass;
    if(l.totalPur===0&&l.totalPaid===0){status='No Purchases';sClass='partial';}
    else if(l.balance===0&&l.overpaid===0){status='✓ Fully Cleared';sClass='clear';}
    else if(l.overpaid>0){status='↑ Overpaid by '+fmt(l.overpaid);sClass='over';}
    else if(l.totalPaid===0){status='✗ Not Paid';sClass='unpaid';}
    else{status='⟳ Partial — Due: '+fmt(l.balance);sClass='partial';}
    const paidPct=l.totalPur>0?Math.min(100,(l.totalPaid/l.totalPur)*100):l.totalPaid>0?100:0;
    return`<div class="led-card">
      <div class="led-hd">
        <div>
          <div class="led-name">${l.name}</div>
          <div class="led-contact">${l.contact||'No contact'}</div>
        </div>
        <button class="btn-pay" onclick="openPayModal('${l.name}')">+ Pay</button>
      </div>
      <div class="led-body">
        <div class="led-stat">
          <div class="led-stat-item"><div class="ls-lbl">Purchased</div><div class="ls-val purchases">${fmt(l.totalPur)}</div></div>
          <div class="led-stat-item"><div class="ls-lbl">Paid</div><div class="ls-val paid">${fmt(l.totalPaid)}</div></div>
          <div class="led-stat-item"><div class="ls-lbl">Balance</div><div class="ls-val balance ${l.balance===0?'zero':''}">${fmt(l.balance)}</div></div>
        </div>
        <div class="led-prog">
          <div class="led-prog-lbl"><span>Payment Progress</span><span>${paidPct.toFixed(1)}%</span></div>
          <div class="led-prog-track"><div id="lf${i}" class="led-prog-fill ${l.overpaid>0?'overpaid':''}" style="width:0%"></div></div>
        </div>
        <div class="led-badges">
          <span class="b bn">${DB.purchases.filter(p=>p.agency===l.name).length} purchases</span>
          <span class="b bn">${DB.payments.filter(p=>p.agency===l.name).length} payments</span>
        </div>
      </div>
      <div class="led-foot">
        <div class="led-status ${sClass}">${status}</div>
        <button class="btn btn-ghost btn-xs" onclick="showAgHistory('${l.name}')">History</button>
      </div>
    </div>`;}).join('');
  setTimeout(()=>ledgers.forEach((l,i)=>{const e=document.getElementById('lf'+i);if(e){const p=l.totalPur>0?Math.min(100,(l.totalPaid/l.totalPur)*100):l.totalPaid>0?100:0;e.style.width=p.toFixed(1)+'%';}}),60);
}

function showAgHistory(name){
  const purs=DB.purchases.filter(r=>r.agency===name).sort((a,b)=>new Date(b.date)-new Date(a.date));
  const pays=DB.payments.filter(r=>r.agency===name).sort((a,b)=>new Date(b.date)-new Date(a.date));
  const l=agLedger(name);
  let msg=`📦 AGENCY: ${name}\n\nPURCHASES (${purs.length}):\n`;
  purs.forEach(p=>msg+=`${fmtD(p.date)}  ${p.product}  ${fmt(p.total)}\n`);
  msg+=`\n💳 PAYMENTS (${pays.length}):\n`;
  pays.forEach(p=>msg+=`${fmtD(p.date)}  ${p.mode||'Cash'}  ${fmt(p.amount)}  ${p.ref?'Ref:'+p.ref:''}\n`);
  msg+=`\n━━━━━━━━━━━━━━━━━━━━\nTotal Purchased: ${fmt(l.totalPur)}\nTotal Paid:      ${fmt(l.totalPaid)}\nBalance Due:     ${fmt(l.balance)}`;
  alert(msg);
}

// ══════════════════════════════
//  AGENCIES
// ══════════════════════════════
function renderAgs(){
  const tb=document.getElementById('ag-tbody'),em=document.getElementById('ag-empty');
  document.getElementById('ag-bdg').textContent=DB.agencies.length;
  if(!DB.agencies.length){tb.innerHTML='';em.style.display='block';return;}
  em.style.display='none';
  tb.innerHTML=DB.agencies.map(ag=>{
    const l=agLedger(ag.name);
    return`<tr>
      <td><strong>${ag.name}</strong>${ag.notes?`<div style="font-size:.72rem;color:var(--text3);">${ag.notes}</div>`:''}</td>
      <td class="tm">${ag.contact||'—'}</td>
      <td class="mono ta">${fmt(l.totalPur)}</td>
      <td class="mono tg">${fmt(l.totalPaid)}</td>
      <td class="mono ${l.balance>0?'tr':'tg'}"><strong>${fmt(l.balance)}</strong></td>
      <td style="display:flex;gap:6px;align-items:center;">
        <button class="btn-pay" onclick="openPayModal('${ag.name}')">Pay</button>
        <button class="btn-del" onclick="delAg('${ag.id}')">✕</button>
      </td>
    </tr>`;}).join('');
}
function saveAg(){
  const name=document.getElementById('ag-name').value.trim();
  if(!name){toast('⚠ Name required','a');return;}
  if(DB.agencies.find(a=>a.name.toLowerCase()===name.toLowerCase())){toast('Already exists','a');return;}
  DB.agencies.push({id:uid(),name,contact:document.getElementById('ag-contact').value.trim(),notes:document.getElementById('ag-note').value.trim()});
  save();['ag-name','ag-contact','ag-note'].forEach(id=>document.getElementById(id).value='');
  renderAgs();toast('✅ Agency added!','g');
}
function delAg(id){if(!confirm('Remove agency?'))return;DB.agencies=DB.agencies.filter(a=>a.id!==id);save();renderAgs();toast('Removed','a');}

// ══════════════════════════════
//  EXPORTS
// ══════════════════════════════
function toCSV(h,rows){return[h.join(','),...rows.map(r=>r.map(c=>'"'+String(c||'').replace(/"/g,'""')+'"').join(','))].join('\n');}
function dl(name,content){const a=document.createElement('a');a.href='data:text/csv;charset=utf-8,'+encodeURIComponent(content);a.download=name;a.click();}
function expAll(){
  const all=[...DB.income.map(r=>['Income',r.date,r.source,r.category,'','',r.amount,r.notes||'']),
    ...DB.purchases.map(r=>['Purchase',r.date,r.product,r.category,r.agency,'',r.total,r.notes||'']),
    ...DB.payments.map(r=>['Payment',r.date,'Payment to '+r.agency,'',r.agency,r.mode,r.amount,r.ref||''])].sort((a,b)=>new Date(b[1])-new Date(a[1]));
  dl('tradeflow-all.csv',toCSV(['Type','Date','Description','Category','Agency','Mode','Amount','Notes'],all));
  toast('📥 Exported!','g');
}
function expPur(){dl('purchases.csv',toCSV(['Date','Product','Agency','Category','Qty','Unit Price','Total','Notes'],fm(DB.purchases).map(r=>[r.date,r.product,r.agency,r.category,r.qty,r.price,r.total,r.notes||''])));toast('📥 Exported','g');}
function expInc(){dl('income.csv',toCSV(['Date','Source','Category','Amount','Notes'],fm(DB.income).map(r=>[r.date,r.source,r.category,r.amount,r.notes||''])));toast('📥 Exported','g');}
function expPay(){dl('payments.csv',toCSV(['Date','Agency','Mode','Reference','Amount','Notes'],fm(DB.payments).map(r=>[r.date,r.agency,r.mode,r.ref||'',r.amount,r.notes||''])));toast('📥 Exported','g');}
function expLedger(){
  const rows=DB.agencies.map(ag=>{const l=agLedger(ag.name);return[ag.name,ag.contact||'',l.totalPur,l.totalPaid,l.balance,l.balance<=0?'CLEARED':'PENDING'];});
  dl('ledger.csv',toCSV(['Agency','Contact','Total Purchased','Total Paid','Balance Due','Status'],rows));
  toast('📥 Ledger exported','g');
}

// ── TOAST ──
function toast(msg,type='g'){
  const t=document.getElementById('toast'),d=document.getElementById('tdot');
  document.getElementById('tmsg').textContent=msg;d.className='tdot '+type;
  t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),3200);
}

// ── RESIZE ──
let _rt;window.addEventListener('resize',()=>{clearTimeout(_rt);_rt=setTimeout(()=>{if(document.getElementById('pg-dashboard').classList.contains('active'))drawBar();},200);});

// ── INIT ──
load();
</script>
