// ── LEDGER CALC per agency ──
function agLedger(agName){
  const totalPur=DB.purchases.filter(r=>r.agency===agName).reduce((s,r)=>s+Number(r.total),0);
  const totalPaid=DB.payments.filter(r=>r.agency===agName).reduce((s,r)=>s+Number(r.amount),0);
  const balance=Math.max(0,totalPur-totalPaid);
  const overpaid=totalPaid>totalPur?totalPaid-totalPur:0;
  const pct=totalPur>0?Math.min(100,(totalPaid/totalPur)*100):totalPaid>0?100:0;
  return{totalPur,totalPaid,balance,overpaid,pct};
}

